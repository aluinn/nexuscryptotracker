{
  "name": "Alert",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Alert title"
    },
    "message": {
      "type": "string",
      "description": "Alert message body"
    },
    "type": {
      "type": "string",
      "enum": [
        "top_stories",
        "portfolio",
        "system"
      ],
      "description": "Alert category"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "asset_tag": {
      "type": "string",
      "description": "Related asset"
    },
    "priority": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    }
  },
  "required": [
    "title",
    "message",
    "type"
  ]
}