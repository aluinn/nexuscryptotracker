{
  "name": "SavedArticle",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Article headline"
    },
    "source": {
      "type": "string",
      "description": "Source publication name"
    },
    "url": {
      "type": "string",
      "description": "Link to the original article"
    },
    "summary": {
      "type": "string",
      "description": "Brief summary of the article"
    },
    "asset_tag": {
      "type": "string",
      "description": "Related cryptocurrency tag"
    },
    "collection": {
      "type": "string",
      "description": "Collection/folder name"
    }
  },
  "required": [
    "title",
    "source"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}