{
  "name": "PortfolioHolding",
  "type": "object",
  "properties": {
    "portfolio_name": {
      "type": "string",
      "description": "Name of the portfolio this holding belongs to",
      "default": "My Portfolio"
    },
    "asset_name": {
      "type": "string",
      "description": "Full name of the cryptocurrency"
    },
    "symbol": {
      "type": "string",
      "description": "Ticker symbol (e.g. BTC, ETH)"
    },
    "amount": {
      "type": "number",
      "description": "Amount of the asset held (calculated from fiat paid)"
    },
    "average_buy_price": {
      "type": "number",
      "description": "Price per unit at time of purchase (in fiat_currency)"
    },
    "fiat_paid": {
      "type": "number",
      "description": "Amount of fiat currency paid"
    },
    "fiat_currency": {
      "type": "string",
      "description": "Currency code used to purchase (e.g. GBP, USD, EUR)"
    }
  },
  "required": [
    "asset_name",
    "symbol",
    "amount"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}